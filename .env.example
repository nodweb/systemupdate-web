# SystemUpdate-Web environment example

# Backend secrets (REQUIRED in prod)
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
DEVICE_ENROLLMENT_KEY=change-me

# Database
DB_NAME=systemupdate
DB_USER=systemupdate
DB_PASSWORD=changeme
DATABASE_URL=postgresql://systemupdate:changeme@localhost:5432/systemupdate

# Cache / Rate limit
REDIS_URL=redis://localhost:6379/0

# Web URLs (Frontend - Vite)
# Vite embeds variables prefixed with VITE_ at build time
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=http://localhost:5000

# Legacy (kept for reference; not used by Vite)
# API_URL=http://localhost:5000
# WS_URL=ws://localhost:5000

# Flask runtime
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
